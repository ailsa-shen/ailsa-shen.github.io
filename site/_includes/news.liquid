<div class="news">
  {% assign news_page = site.pages | where: 'url', '/news/' | first %}
  {% assign news_items = news_page.news_items %}
  {% if news_items != blank %}
    {% assign news_size = news_items | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = news_items | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" class="news-date">{{ item.date | date: '%b %Y' }}</th>
            <td>{{ item.text | markdownify | remove: '<p>' | remove: '</p>' | emojify }}</td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
