{% assign teaching_page = site.pages | where: 'url', '/teaching/' | first %}
{% assign all_courses = teaching_page.courses | sort: 'sort_order' | reverse %}
{% if all_courses != blank %}
  <div class="courses">
    <div class="course-list">
      {% for course in all_courses %}
        <div class="course-item">
          <h3 class="course-title">{{ course.title }}</h3>

          <div class="course-meta">
            {% if course.term and course.year %}
              <span class="course-term">
                {{- course.term }}
                {{ course.year -}}
              </span>
            {% endif %}

            {% if course.instructor %}
              <span class="course-instructor">{{ course.instructor }}</span>
            {% endif %}
          </div>

          {% if course.description %}
            <div class="course-description">
              {{ course.description | markdownify }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}
